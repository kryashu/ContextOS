# ============================================
# ContextOS Multi-Provider LLM Configuration
# ============================================

# PRIMARY LLM PROVIDER (required)
# Choose: gemini | groq | openai | ollama | mock
# Recommended: groq (free tier: 14.4K requests/day)
LLM_PROVIDER=groq

# LOCAL LLM PROVIDER (optional)
# Used for lightweight tasks (classification, summarization)
# Choose: ollama
LOCAL_LLM_PROVIDER=ollama

# OLLAMA CONFIGURATION
# Local model for fast, lightweight tasks
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Install: brew install ollama && ollama pull llama3.2:3b

# FALLBACK CONFIGURATION
# Enable fallback to Ollama when primary provider fails
ENABLE_LOCAL_FALLBACK=true
# Maximum document size for Ollama fallback (in KB)
LOCAL_FALLBACK_MAX_SIZE_KB=50
# Maximum tokens for Ollama fallback (8000 ≈ 32KB text)
LOCAL_FALLBACK_MAX_TOKENS=8000

# ============================================
# API KEYS (get one of these)
# ============================================

# GROQ (recommended - free tier)
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# GOOGLE GEMINI (recommended - low cost)
# Get your key at: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OPENAI (expensive, requires credits)
# Get your key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# HARDWARE-LIGHT SETUP (Recommended)
# ============================================
# For running ContextOS with minimal hardware requirements:
#
# 1. Install Ollama (local, free):
#    brew install ollama
#    ollama pull llama3.2:3b
#
# 2. Get free Groq API key:
#    https://console.groq.com
#    Free tier: 14,400 requests/day
#
# 3. Configure:
#    LLM_PROVIDER=groq
#    LOCAL_LLM_PROVIDER=ollama
#    ENABLE_LOCAL_FALLBACK=true
#    GROQ_API_KEY=your_key
#
# Result:
# - Classification/summarization: Ollama (local, fast)
# - Entity extraction: Groq (hosted, high quality) with Ollama fallback
# - Relationship mapping: Groq only (no fallback for complex tasks)
# - Total RAM: ~4GB for Ollama + minimal for Node.js
#
# ============================================
# TASK ROUTING TABLE
# ============================================
# Classification      → Ollama 3b (local, fast)
# Summarization       → Ollama 3b (local, fast)
# Entity Extraction   → Groq/Gemini (hosted) with Ollama fallback*
# Relationship Map    → Groq/Gemini (hosted, no fallback)
# Artifact Generation → Groq/Gemini (hosted, no fallback)
#
# *Fallback only if ENABLE_LOCAL_FALLBACK=true and document < 50KB
